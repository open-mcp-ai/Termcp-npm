# Only bin/termcp.js ships (see "files" in package.json). Everything below is a
# second line of defence so a stray file can never end up in the tarball.

# Metadata and tooling
.git/
.github/
.gitignore
.npmignore
.editorconfig
npm-debug.log*
yarn-error.log*
.npmrc
.eslintrc*
.prettierrc*
.stylelintrc*
commitlint.config.*
lint-staged.config.*
tsconfig*.json

# Tests and fixtures
test/
tests/
__tests__/
*.test.js
*.spec.js
coverage/
.nyc_output/
*.lcov

# Docs and generated output (upstream README is the documentation)
docs/
CHANGELOG*
*.md
!README.md
bin/termcp.js.map
dist/
out/
*.tgz
*.vsix

# CI
.travis.yml
appveyor.yml
zuul.yml
circle.yml
.gitlab-ci.yml
azure-pipelines.yml
.circleci/

# Lock files (the package has no dependencies)
package-lock.json
pnpm-lock.yaml
yarn.lock

